# Backend settings only. Copy to .env and start the backend from the repository root.
# No credentials or model API keys are required. Paths are relative to that root.
SANYOJAN_DATABASE_PATH=data/tasks.sqlite3
SANYOJAN_REPORTS_DIR=data/reports
SANYOJAN_FRONTEND_DIR=frontend/dist
SANYOJAN_HEADLESS=true

# Bounds enforced by Settings: task 5–180 s, action 1000–30000 ms,
# page 1024–5000000 bytes, records 1–200, redirects 0–5,
# concurrent tasks 1–4, stored tasks 10–10000.
SANYOJAN_TASK_TIMEOUT_SECONDS=60
SANYOJAN_ACTION_TIMEOUT_MS=15000
SANYOJAN_MAX_PAGE_BYTES=2000000
SANYOJAN_MAX_RECORDS=100
SANYOJAN_MAX_REDIRECTS=3
SANYOJAN_MAX_CONCURRENT_TASKS=2
SANYOJAN_MAX_STORED_TASKS=1000

# Lists MUST be JSON arrays, not comma-separated strings or Python list literals.
# Exact public hostnames only; adding a domain does not add an extraction profile.
# The exact virtual demo URL needs no allowlist entry and never resolves over DNS.
SANYOJAN_ALLOWED_DOMAINS=["books.toscrape.com"]
SANYOJAN_CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
SANYOJAN_TRUSTED_HOSTS=["127.0.0.1","localhost","testserver"]

# Frontend configuration belongs in frontend/.env, copied from its own example.
# VITE_API_BASE_URL is intentionally absent here; leave it empty for same-origin /api.
